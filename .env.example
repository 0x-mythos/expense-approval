# --- App ---
# Secret for signing session cookies. Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# --- Database ---
# Used by the app inside docker-compose. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg2://expense:expense@db:5432/expense

# --- AI (Anthropic) ---
# The AI helper is OPTIONAL at runtime: if no key is set (or the call fails/times out),
# the app degrades gracefully — claims still flow, the approver just sees "AI unavailable".
ANTHROPIC_API_KEY=

# Model for the AI summary + inconsistency flag. A lightweight classification task,
# so a fast/cheap model is plenty (this is the tested default).
AI_MODEL=claude-haiku-4-5

# Hard timeout (seconds) for a single AI call. Keeps the UI snappy; on timeout we fall back.
AI_TIMEOUT_SECONDS=12

# Extra (beyond the task spec): on submit, if the AI confidently flags a wrong category
# it also auto-corrects and re-routes. Set to false for pure "flag only" behaviour.
AI_AUTO_CATEGORIZE=true
