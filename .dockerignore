.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtualenvs
.venv/
venv/
env/

# VCS & editor
.git/
.gitignore
.idea/
.vscode/
*.swp

# Docs/state that don't belong in the runtime image
*.md
!README.md
